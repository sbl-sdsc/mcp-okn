      v1 -."rdfs:label".-> v4
    end
    subgraph optionalgraph01["(optional)"]
    style optionalgraph01 fill:#bbf,stroke-dasharray: 5 5,color:#000;
      v3 -."rdfs:label".-> v5
    end
  end
