PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX kg: <https://purl.org/okn/frink/kg/spoke-okn/schema/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# County Health Rankings 2023 county-native measures (spoke-okn PREVALENCEIN_SpL), one row per county; value parsed from "v(quartile)"; -999 = missing; state FIPS 35-48
SELECT ?fips (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_diabetes_prevalence>, ?x, -999)) AS ?chr_diabetes) (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/414916001>, ?x, -999)) AS ?chr_obesity) (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/77176002>, ?x, -999)) AS ?smoking) (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/415510005>, ?x, -999)) AS ?inactivity) (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/105436006>, ?x, -999)) AS ?age65) (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_non-hispanic_black>, ?x, -999)) AS ?nh_black) (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/414408004>, ?x, -999)) AS ?hispanic) (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_rural>, ?x, -999)) AS ?rural) (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_children_in_poverty>, ?x, -999)) AS ?child_poverty) (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_uninsured_adults>, ?x, -999)) AS ?uninsured) (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_some_college>, ?x, -999)) AS ?some_college) (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/733423003>, ?x, -999)) AS ?food_insec) (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_frequent_physical_distress>, ?x, -999)) AS ?phys_distress) (MAX(IF(?s = <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_life_expectancy>, ?x, -999)) AS ?life_exp) WHERE {
  GRAPH <https://purl.org/okn/frink/kg/spoke-okn> {
    VALUES ?s { <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_diabetes_prevalence> <https://purl.org/okn/frink/kg/spoke-okn/sdoh/414916001> <https://purl.org/okn/frink/kg/spoke-okn/sdoh/77176002> <https://purl.org/okn/frink/kg/spoke-okn/sdoh/415510005> <https://purl.org/okn/frink/kg/spoke-okn/sdoh/105436006> <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_non-hispanic_black> <https://purl.org/okn/frink/kg/spoke-okn/sdoh/414408004> <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_rural> <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_children_in_poverty> <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_uninsured_adults> <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_some_college> <https://purl.org/okn/frink/kg/spoke-okn/sdoh/733423003> <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_frequent_physical_distress> <https://purl.org/okn/frink/kg/spoke-okn/sdoh/CHR_life_expectancy> }
    ?stmt rdf:predicate kg:PREVALENCEIN_SpL ; rdf:subject ?s ; rdf:object ?c ; dcterms:source "County Health Rankings" ; kg:value ?v .
    ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#> <http://www.wikidata.org/entity/Q28575> ; kg:state_fips ?sf .
    FILTER((?sf >= "35" && ?sf <= "48") && BOUND(?stmt))
    BIND(ROUND(10*xsd:decimal(STRBEFORE(CONCAT(STR(?v), "("), "(")))/10 AS ?x)
    BIND(REPLACE(STR(?c), "^.*/location/", "") AS ?fips)
  }
} GROUP BY ?fips
