PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX kg: <https://purl.org/okn/frink/kg/spoke-okn/schema/>
PREFIX sd: <https://purl.org/okn/frink/kg/spoke-okn/sdoh/>
PREFIX rst: <http://sail.ua.edu/ruralkg/settlementtype/>
# Q7 - Native county measures (spoke-okn: CHR 2023, AHRQ SDOH 2018-2020) pivoted one row per county + RUCC (ruralkg); state FIPS 41-56
SELECT ?fips ?county ?state ?rucc ?diabetes ?obesity ?asthma ?copd ?arthritis ?ckd ?high_chol ?mental_distress ?physical_distress ?heart_mort ?stroke_mort ?heart_hosp ?stroke_hosp ?pop ?age65 ?black ?hispanic ?bachelor ?income ?poverty ?rural ?smoking ?inactivity ?food_env WHERE {
 { SELECT ?fips (SAMPLE(?cn) AS ?county) (SAMPLE(?sn) AS ?state)
    (MAX(IF(?col="diabetes",?num,?u)) AS ?diabetes) (MAX(IF(?col="obesity",?num,?u)) AS ?obesity) (MAX(IF(?col="asthma",?num,?u)) AS ?asthma)
    (MAX(IF(?col="copd",?num,?u)) AS ?copd) (MAX(IF(?col="arthritis",?num,?u)) AS ?arthritis) (MAX(IF(?col="ckd",?num,?u)) AS ?ckd)
    (MAX(IF(?col="high_chol",?num,?u)) AS ?high_chol) (MAX(IF(?col="mental_distress",?num,?u)) AS ?mental_distress) (MAX(IF(?col="physical_distress",?num,?u)) AS ?physical_distress)
    (MAX(IF(?col="heart_mort",?num,?u)) AS ?heart_mort) (MAX(IF(?col="stroke_mort",?num,?u)) AS ?stroke_mort) (MAX(IF(?col="heart_hosp",?num,?u)) AS ?heart_hosp) (MAX(IF(?col="stroke_hosp",?num,?u)) AS ?stroke_hosp)
    (MAX(IF(?col="pop",?num,?u)) AS ?pop) (MAX(IF(?col="age65",?num,?u)) AS ?age65) (MAX(IF(?col="black",?num,?u)) AS ?black) (MAX(IF(?col="hispanic",?num,?u)) AS ?hispanic)
    (MAX(IF(?col="bachelor",?num,?u)) AS ?bachelor) (MAX(IF(?col="income",?num,?u)) AS ?income) (MAX(IF(?col="poverty",?num,?u)) AS ?poverty) (MAX(IF(?col="rural",?num,?u)) AS ?rural)
    (MAX(IF(?col="smoking",?num,?u)) AS ?smoking) (MAX(IF(?col="inactivity",?num,?u)) AS ?inactivity) (MAX(IF(?col="food_env",?num,?u)) AS ?food_env)
   WHERE {
    VALUES (?sdoh ?col ?yr) {
      (sd:CHR_diabetes_prevalence "diabetes" "2023") (sd:414916001 "obesity" "2023") (sd:CDCP_ASTHMA_ADULT_A "asthma" "2019")
      (sd:CDCP_PULMONARY_ADULT_A "copd" "2019") (sd:CDCP_ARTHRITIS_ADULT_A "arthritis" "2019") (sd:CDCP_KIDNEY_DISEASE_ADULT_A "ckd" "2019")
      (sd:CDCP_CHOLES_ADULT_A "high_chol" "2019") (sd:CHR_frequent_mental_distress "mental_distress" "2023") (sd:CHR_frequent_physical_distress "physical_distress" "2023")
      (sd:CDCA_HEART_DTH_RATE_ABOVE35 "heart_mort" "2019") (sd:CDCA_STROKE_DTH_RATE_ABOVE35 "stroke_mort" "2019")
      (sd:CDCA_HEART_HOSP_RATE_ABOVE65 "heart_hosp" "2018") (sd:CDCA_STROKE_HOSP_RATE_ABOVE65 "stroke_hosp" "2018")
      (sd:ACS_TOT_POP_WT "pop" "2020") (sd:ACS_PCT_AGE_ABOVE65 "age65" "2020") (sd:ACS_PCT_BLACK_NONHISP "black" "2020")
      (sd:ACS_PCT_HISPANIC "hispanic" "2020") (sd:ACS_PCT_BACHELOR_DGR "bachelor" "2020") (sd:ACS_MEDIAN_HH_INC "income" "2020")
      (sd:SAIPE_PCT_POV "poverty" "2020") (sd:CHR_rural "rural" "2023") (sd:77176002 "smoking" "2023")
      (sd:CDCP_NO_PHY_ACTV_ADULT_A "inactivity" "2019") (sd:CHR_food_environment_index "food_env" "2023") }
    GRAPH <https://purl.org/okn/frink/kg/spoke-okn> {
      ?stmt rdf:subject ?sdoh ; rdf:predicate kg:PREVALENCEIN_SpL ; rdf:object ?loc ; kg:value ?val ; kg:year ?y .
      ?loc rdfs:label ?cn ; kg:state_name ?sn .
    }
    FILTER(STR(?y) = ?yr)
    BIND(STRAFTER(STR(?loc), "/location/") AS ?fips)
    FILTER(REGEX(?fips, "^(4[1-9]|5[0-6])[0-9]{3}$"))
    BIND(xsd:double(IF(CONTAINS(STR(?val),"("), STRBEFORE(STR(?val),"("), STR(?val))) AS ?num)
   } GROUP BY ?fips }
 BIND(IRI(CONCAT("http://stko-kwg.geog.ucsb.edu/lod/resource/administrativeRegion.USA.", ?fips)) AS ?reg)
 OPTIONAL { GRAPH <https://purl.org/okn/frink/kg/ruralkg> { ?cs rst:censusCounty ?reg ; rst:hasRUCC ?r . } }
 BIND(REPLACE(STR(?r), "^.*[^0-9]([0-9]+)$", "$1") AS ?rucc)
} ORDER BY ?fips LIMIT 999
