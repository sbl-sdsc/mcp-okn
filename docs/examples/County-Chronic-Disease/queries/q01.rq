PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX kg: <https://purl.org/okn/frink/kg/spoke-okn/schema/>
# Q1 - Inventory of disease-prevalence statements in spoke-okn: source, geography level, measure type
SELECT ?source ?location_kind ?data_value_type (COUNT(DISTINCT ?disease) AS ?n_diseases) (COUNT(?stmt) AS ?n_statements) (COUNT(DISTINCT ?loc) AS ?n_locations) (SAMPLE(?yr) AS ?year) WHERE {
  GRAPH <https://purl.org/okn/frink/kg/spoke-okn> {
    ?stmt rdf:predicate kg:PREVALENCE_DpL ; rdf:subject ?disease ; rdf:object ?loc .
    OPTIONAL { ?stmt dcterms:source ?source }
    OPTIONAL { ?stmt kg:data_value_type ?data_value_type }
    OPTIONAL { ?stmt kg:year ?yr }
    OPTIONAL { ?loc <http://www.w3.org/1999/02/22-rdf-syntax-ns#> ?location_kind }
  }
} GROUP BY ?source ?location_kind ?data_value_type
