SELECT (REPLACE(STR(?p),"^.*[/#]","") AS ?pred) (STR(?cat) AS ?category) (COUNT(DISTINCT ?s) AS ?n) WHERE {
  GRAPH <https://purl.org/okn/frink/kg/ubergraph> { ?mondo <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/DOID_2377> ; <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UMLS:C0026769" . }
  GRAPH <https://purl.org/okn/frink/kg/biohealth> {
    VALUES ?p { <https://w3id.org/biolink/vocab/predisposes_to_condition> <https://w3id.org/biolink/vocab/causes> <https://w3id.org/biolink/vocab/preventative_for_condition> }
    ?s ?p <https://biohealthkg.proto-okn.net/kg/node/C0026769> . OPTIONAL { ?s <https://w3id.org/biolink/vocab/category> ?cat }
  }
} GROUP BY ?p ?cat
