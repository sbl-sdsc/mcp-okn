SELECT (REPLACE(STR(?assay),"^.*/","") AS ?a) (SUM(IF(?l > 0,1,0)) AS ?n_up) (SUM(IF(?l < 0,1,0)) AS ?n_down) WHERE {
  GRAPH <https://purl.org/okn/frink/kg/gene-expression-atlas-okn> {
    VALUES ?assay { <http://purl.org/okn/wobd/assay/E-GEOD-60424-g11_g10> <http://purl.org/okn/wobd/assay/E-GEOD-60424-g11_g9> <http://purl.org/okn/wobd/assay/E-GEOD-60424-g17_g15> <http://purl.org/okn/wobd/assay/E-GEOD-60424-g17_g16> <http://purl.org/okn/wobd/assay/E-GEOD-60424-g25_g23> <http://purl.org/okn/wobd/assay/E-GEOD-60424-g25_g24> <http://purl.org/okn/wobd/assay/E-GEOD-60424-g31_g29> <http://purl.org/okn/wobd/assay/E-GEOD-60424-g31_g30> <http://purl.org/okn/wobd/assay/E-GEOD-60424-g37_g35> <http://purl.org/okn/wobd/assay/E-GEOD-60424-g37_g36> <http://purl.org/okn/wobd/assay/E-GEOD-60424-g5_g3> <http://purl.org/okn/wobd/assay/E-GEOD-60424-g5_g4> <http://purl.org/okn/wobd/assay/E-GEOD-32645-g3_g4> <http://purl.org/okn/wobd/assay/E-GEOD-66573-g1_g2> <http://purl.org/okn/wobd/assay/E-GEOD-77598-g2_g1> <http://purl.org/okn/wobd/assay/E-MTAB-2973-g3_g2> <http://purl.org/okn/wobd/assay/E-MTAB-69-g3_g1> <http://purl.org/okn/wobd/assay/E-MTAB-69-g4_g2> <http://purl.org/okn/wobd/assay/E-GEOD-14386-g2_g1> <http://purl.org/okn/wobd/assay/E-GEOD-26104-g7_g1> <http://purl.org/okn/wobd/assay/E-GEOD-26104-g7_g2> <http://purl.org/okn/wobd/assay/E-GEOD-26104-g7_g3> <http://purl.org/okn/wobd/assay/E-GEOD-26104-g7_g4> <http://purl.org/okn/wobd/assay/E-GEOD-26104-g7_g5> <http://purl.org/okn/wobd/assay/E-GEOD-26104-g7_g6> <http://purl.org/okn/wobd/assay/E-MTAB-2973-g2_g1> <http://purl.org/okn/wobd/assay/E-GEOD-23205-g1_g2> }
    ?x <https://w3id.org/biolink/vocab/subject> ?assay ; <http://purl.org/okn/wobd/log2fc> ?l ; <http://purl.org/okn/wobd/adj_p_value> ?p .
    FILTER(?p <= 0.05 && ABS(?l) >= 1)
  }
} GROUP BY ?assay
