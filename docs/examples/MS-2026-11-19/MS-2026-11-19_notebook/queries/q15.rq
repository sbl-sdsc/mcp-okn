PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?mondo ?d ?dlabel ?p (COUNT(DISTINCT ?o) AS ?n) WHERE {
  GRAPH <https://purl.org/okn/frink/kg/spoke-okn> { BIND(<http://purl.obolibrary.org/obo/DOID_2377> AS ?doid) ?doid a <https://w3id.org/biolink/vocab/Disease> . }
  GRAPH <https://purl.org/okn/frink/kg/ubergraph> { ?mondo <http://www.w3.org/2004/02/skos/core#exactMatch> ?doid . }
  GRAPH <https://purl.org/okn/frink/kg/rdkg> {
    { BIND(?mondo AS ?d) } UNION { ?d <https://w3id.org/biolink/vocab/subclass_of> ?mondo }
    ?d ?p ?o . OPTIONAL { ?d rdfs:label ?dlabel }
    FILTER(?p != <https://w3id.org/biolink/vocab/subclass_of>)
  }
} GROUP BY ?mondo ?d ?dlabel ?p
