PREFIX kg: <https://purl.org/okn/frink/kg/spoke-okn/schema/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?gene ?symbol ?ensembl WHERE {
  GRAPH <https://purl.org/okn/frink/kg/spoke-okn> {
    <http://purl.obolibrary.org/obo/DOID_2377> kg:ASSOCIATES_DaG ?gene .
    OPTIONAL { <http://purl.obolibrary.org/obo/DOID_2377> kg:ASSOCIATES_DaG ?gene . ?gene rdfs:label ?symbol }
    OPTIONAL { <http://purl.obolibrary.org/obo/DOID_2377> kg:ASSOCIATES_DaG ?gene . ?gene kg:ensembl ?ensembl }
  }
}
