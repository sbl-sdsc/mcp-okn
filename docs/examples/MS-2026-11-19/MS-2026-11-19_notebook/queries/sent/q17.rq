      FILTER(?p IN (<https://w3id.org/biolink/vocab/related_to>, <https://w3id.org/biolink/vocab/contributes_to>, <https://w3id.org/biolink/vocab/contraindicated_for>, <https://w3id.org/biolink/vocab/has_onset>, <https://w3id.org/biolink/vocab/has_mode_of_inheritance>, <https://w3id.org/biolink/vocab/genetic_association>, <https://w3id.org/biolink/vocab/has_phenotype>))
