    BIND(<http://purl.obolibrary.org/obo/MONDO_0000452> AS ?d)
  }
  UNION
  {
    ?x ?p <http://purl.obolibrary.org/obo/MONDO_0005284> . BIND("in" AS ?dir) FILTER(?p != <https://w3id.org/biolink/vocab/subclass_of>)
    BIND(<http://purl.obolibrary.org/obo/MONDO_0005284> AS ?d)
  }
  UNION
  {
    ?x ?p <http://purl.obolibrary.org/obo/MONDO_0016429> . BIND("in" AS ?dir) FILTER(?p != <https://w3id.org/biolink/vocab/subclass_of>)
    BIND(<http://purl.obolibrary.org/obo/MONDO_0016429> AS ?d)
  }
  UNION
  {
    ?x ?p <http://purl.obolibrary.org/obo/MONDO_0018784> . BIND("in" AS ?dir) FILTER(?p != <https://w3id.org/biolink/vocab/subclass_of>)
    BIND(<http://purl.obolibrary.org/obo/MONDO_0018784> AS ?d)
  }
}
    OPTIONAL { ?x rdfs:label ?xlabel } OPTIONAL { ?x a ?xtype }
  }
} GROUP BY ?dir ?d ?p ?x ?xlabel
