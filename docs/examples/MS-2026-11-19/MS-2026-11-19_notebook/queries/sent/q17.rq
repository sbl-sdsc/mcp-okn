}
    UNION
    {
  {
    ?x ?p <http://purl.obolibrary.org/obo/MONDO_0005301> . BIND("in" AS ?dir) FILTER(?p != <https://w3id.org/biolink/vocab/subclass_of>)
    BIND(<http://purl.obolibrary.org/obo/MONDO_0005301> AS ?d)
  }
  UNION
  {
    ?x ?p <http://purl.obolibrary.org/obo/MONDO_0005314> . BIND("in" AS ?dir) FILTER(?p != <https://w3id.org/biolink/vocab/subclass_of>)
