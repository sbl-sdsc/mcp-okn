PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX kg: <https://purl.org/okn/frink/kg/spoke-okn/schema/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?dir ?other ?label ?cooccur ?enrichment ?odds ?fisher WHERE {
  GRAPH <https://purl.org/okn/frink/kg/spoke-okn> {
    { ?st rdf:subject <http://purl.obolibrary.org/obo/DOID_2377> ; rdf:predicate kg:RESEMBLES_DrD ; rdf:object ?other . BIND("out" AS ?dir) }
    UNION
    { ?st rdf:subject ?other ; rdf:predicate kg:RESEMBLES_DrD ; rdf:object <http://purl.obolibrary.org/obo/DOID_2377> . BIND("in" AS ?dir) }
    OPTIONAL { ?other rdfs:label ?label }
    OPTIONAL { ?st kg:cooccur ?cooccur } OPTIONAL { ?st kg:enrichment ?enrichment } OPTIONAL { ?st kg:odds ?odds } OPTIONAL { ?st kg:fisher ?fisher }
  }
}
