PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?mondo ?d ?dlabel ?p (COUNT(DISTINCT ?o) AS ?n) WHERE {
  GRAPH <https://purl.org/okn/frink/kg/spoke-okn> { <http://purl.obolibrary.org/obo/DOID_2377> a <https://w3id.org/biolink/vocab/Disease> . }
  GRAPH <https://purl.org/okn/frink/kg/ubergraph> { ?mondo <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/DOID_2377> . }
  GRAPH <https://purl.org/okn/frink/kg/rdkg> {
    ?d <https://w3id.org/biolink/vocab/subclass_of>? ?mondo .
    ?d a <https://w3id.org/biolink/vocab/Disease> ; ?p ?o . OPTIONAL { ?d rdfs:label ?dlabel }
    FILTER(?p NOT IN (<https://w3id.org/biolink/vocab/subclass_of>, rdf:type, rdfs:label, skos:prefLabel, <https://w3id.org/biolink/vocab/category>, <https://w3id.org/biolink/vocab/id>))
  }
} GROUP BY ?mondo ?d ?dlabel ?p
