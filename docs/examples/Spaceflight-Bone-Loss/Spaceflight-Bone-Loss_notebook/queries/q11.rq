PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX oio: <http://www.geneontology.org/formats/oboInOwl#>
SELECT DISTINCT ?term ?label ?matched_on ?matched_text WHERE {
  GRAPH <https://purl.org/okn/frink/kg/ubergraph> {
    { VALUES ?lit { "bone mineral density" "bone mineral density"@en "Bone mineral density" "Bone mineral density"@en "Bone Mineral Density" "Bone Mineral Density"@en } ?term rdfs:label ?lit . BIND("label" AS ?matched_on) }
    UNION
    { VALUES ?lit { "bone mineral density" "bone mineral density"@en "Bone mineral density" "Bone mineral density"@en "Bone Mineral Density" "Bone Mineral Density"@en } ?term oio:hasExactSynonym ?lit . BIND("exact_synonym" AS ?matched_on) }
    UNION
    { VALUES ?lit { "bone mineral density" "bone mineral density"@en "Bone mineral density" "Bone mineral density"@en "Bone Mineral Density" "Bone Mineral Density"@en } ?term oio:hasRelatedSynonym ?lit . BIND("related_synonym" AS ?matched_on) }
    UNION
    { VALUES ?lit { "bone mineral density" "bone mineral density"@en "Bone mineral density" "Bone mineral density"@en "Bone Mineral Density" "Bone Mineral Density"@en } ?term oio:hasNarrowSynonym ?lit . BIND("narrow_synonym" AS ?matched_on) }
    UNION
    { VALUES ?lit { "bone mineral density" "bone mineral density"@en "Bone mineral density" "Bone mineral density"@en "Bone Mineral Density" "Bone Mineral Density"@en } ?term oio:hasBroadSynonym ?lit . BIND("broad_synonym" AS ?matched_on) }
    OPTIONAL { ?term rdfs:label ?label }
  }
  BIND(STR(?lit) AS ?matched_text)
} LIMIT 25
