PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?anat ?label (COUNT(DISTINCT ?assay) AS ?nAssays) WHERE {
  GRAPH <https://purl.org/okn/frink/kg/spoke-genelab> {
    ?assay <https://purl.org/okn/frink/kg/spoke-genelab/schema/INVESTIGATED_ASiA> ?anat .
    OPTIONAL { ?anat rdfs:label ?label }
  }
} GROUP BY ?anat ?label
